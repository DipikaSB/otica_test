<?php
/** @var $block \Magento\Catalog\Block\Product\View */
?>
<div class="setblue-sales-counter" id="setblue-sales-counter">
    <img
        src="<?= $block->getViewFileUrl('Magento_Catalog::images/rush.webp') ?>"
        alt="Hot product"
        class="sales-icon"
    />
    <span class="sales-text"></span>
</div>

<script>
require(['jquery'], function ($) {
    'use strict';

    var minSold  = 3;
    var maxSold  = 12;
    var minHours = 1;
    var maxHours = 24;

    function getRandom(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    var sold  = getRandom(minSold, maxSold);
    var hours = getRandom(minHours, maxHours);

    var text = sold + ' sold in last ' + hours + ' hours';

    $('#setblue-sales-counter .sales-text').text(text);
});
</script>

