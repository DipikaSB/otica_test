<!-- Star Rating Interaction & Validation Script -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.rating-stars').forEach(function (container) {
            var labels = container.querySelectorAll('.star-label');
            var inputs = container.querySelectorAll('.star-input');

            labels.forEach(function (label, index) {
                // Hover: highlight this star and all preceding stars
                label.addEventListener('mouseenter', function () {
                    labels.forEach(function (l, i) {
                        l.classList.toggle('hovered', i <= index);
                    });
                });

                // Click: select the corresponding radio and mark stars
                label.addEventListener('click', function () {
                    inputs[index].checked = true;
                    labels.forEach(function (l, i) {
                        l.classList.toggle('selected', i <= index);
                    });
                    // Hide error when a rating is selected
                    var errorMsg = document.getElementById('rating-error-msg');
                    if (errorMsg) {
                        errorMsg.style.display = 'none';
                    }
                });
            });

            // Mouse leave: remove hover state, keep selected state
            container.addEventListener('mouseleave', function () {
                labels.forEach(function (l) {
                    l.classList.remove('hovered');
                });
            });
        });

        // Form submit validation: check star ratings are selected
        var form = document.getElementById('reviewreminder-review-form');
        if (form) {
            form.addEventListener('submit', function (e) {
                var ratingContainers = form.querySelectorAll('.rating-stars');
                var allRated = true;

                ratingContainers.forEach(function (container) {
                    var inputs = container.querySelectorAll('.star-input');
                    var anyChecked = false;
                    inputs.forEach(function (input) {
                        if (input.checked) {
                            anyChecked = true;
                        }
                    });
                    if (!anyChecked) {
                        allRated = false;
                    }
                });

                if (!allRated) {
                    e.preventDefault();
                    var errorMsg = document.getElementById('rating-error-msg');
                    if (errorMsg) {
                        errorMsg.style.display = 'block';
                    }
                    // Scroll to the rating section
                    var ratingsSection = form.querySelector('.review-ratings');
                    if (ratingsSection) {
                        ratingsSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    return false;
                }
            });
        }
    });
</script>

<?php else: ?>
