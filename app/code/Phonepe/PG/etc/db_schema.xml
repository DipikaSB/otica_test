<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
        <table name="phonepe_order_status_check" resource="default" engine="innodb" comment="PhonePe Order Status Check Queue">
                <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
                <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Magento Order ID"/>
                <column xsi:type="varchar" name="merchant_transaction_id" nullable="false" length="255" comment="Merchant Transaction ID"/>
                <column xsi:type="int" name="check_count" padding="10" unsigned="true" nullable="false" comment="Total Check Count"/>
                <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
                <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Update Time"/>
                <constraint xsi:type="primary" referenceId="PRIMARY">
                        <column name="entity_id"/>
                </constraint>
                <constraint xsi:type="foreign" referenceId="PHONEPE_ORDER_STATUS_CHECK_ORDER_ID_SALES_ORDER_ENTITY_ID" table="phonepe_order_status_check" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
                <index referenceId="PHONEPE_ORDER_STATUS_CHECK_ORDER_ID" indexType="btree">
                        <column name="order_id"/>
                </index>
        </table>
</schema>

