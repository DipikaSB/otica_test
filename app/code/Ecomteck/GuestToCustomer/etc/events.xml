<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="ecomteck_guest_to_customer_save">
        <observer name="ecomteck_guest_to_customer_save_downloadable_product"
                  instance="Ecomteck\GuestToCustomer\Observer\UpdateDownloadableProductObserver" />
    </event>
    <event name="checkout_onepage_controller_success_action">
        <observer name="ecomteck_guest_to_customer_auto_convert" instance="Ecomteck\GuestToCustomer\Observer\AutoCreateCustomerAccount"/>
    </event>
</config>
