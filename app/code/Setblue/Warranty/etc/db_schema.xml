<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
	<!-- Sns_Warranty table starts. -->
	<table name="Sns_Warranty" resource="default" engine="innodb" comment="Primary table of Sns_Warranty that stores information Sns_Warranty, contact number and website details.">
		<column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true" comment="id" />
		<column xsi:type="varchar" name="fname" length="1024" nullable="false" comment="First Name" />
		<column xsi:type="varchar" name="lname" length="1024" nullable="false" comment="Last Name" />
		<column xsi:type="varchar" name="phone_no" length="1024" nullable="false" comment="Phone No" />
		<column xsi:type="varchar" name="email" length="1024" nullable="false" comment="Email Id" />
		<column xsi:type="varchar" name="product_name" length="1024" nullable="false" comment="Product Name" />
		<column xsi:type="varchar" name="serial_no" length="1024" nullable="false" comment="Serial No" />
		<column xsi:type="varchar" name="purchase_date" length="1024" nullable="false" comment="Purchase Date" />
		<column xsi:type="varchar" name="purchase_receipt" length="1024" nullable="false" comment="Purchase Receipt" />
		<column xsi:type="varchar" name="created_date" length="1024" nullable="false" comment="Created Date" />
    	<constraint xsi:type="primary" referenceId="PRIMARY">
			<column name="id" />
		</constraint>
	</table>
	<!-- Sns_Warranty table ends. -->
</schema>
