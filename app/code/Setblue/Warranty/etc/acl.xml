<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../lib/internal/Magento/Framework/Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Setblue_Warranty::acl_top_warranty" title="Warranty" sortOrder="50">
                                <resource id="Setblue_Warranty::acl_warranty_list" title="List Of Customer Warranty" sortOrder="10"/>
                                <resource id="Setblue_Warranty::acl_config" title="Configuration" sortOrder="20"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
