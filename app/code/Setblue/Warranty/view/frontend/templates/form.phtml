<script>

require(['jquery', 'mage/validation', 'mage/loader'], function($){

    $(document).on("click", "#btn-warranty-inquiry", function (e) {
        e.preventDefault();

        var form = $(".cls-warranty-inquiry-form");

        if (!form.validation('isValid')) {
            return false;
        }

        var fileInput = $('#purchase_receipt')[0].files[0];
        if (!fileInput) {
            alert("Please select a purchase receipt");
            return false;
        }

        var allowedExt = ['jpg', 'jpeg', 'png'];

        var fileName = fileInput.name.toLowerCase();
        var fileExt = fileName.split('.').pop();

        if ($.inArray(fileExt, allowedExt) === -1) {
            alert("Invalid file type. Allowed: jpg, jpeg, png");
            $('#purchase_receipt').val(""); 
            return false;
        }

        $('body').loader('show');

        var formData = new FormData();
        formData.append('fname', $('#fname').val());
        formData.append('lname', $('#lname').val());
        formData.append('email_id', $('#cls-email').val());
        formData.append('phone', $('#phone').val());
        formData.append('product_name', $('#productname').val());
        formData.append('serial_no', $('#serial_no').val());
        formData.append('purchase_date', $('#purchase_date').val());
        formData.append('purchase_receipt', $('#purchase_receipt')[0].files[0]);

        $.ajax({
            url: '<?= $block->getforendSave(); ?>',
            type: 'POST',
            data: formData,
            contentType: false,     // required
            processData: false,     // required
            dataType: 'json',

            success: function (response) {

                $('body').loader('hide');

                if (response.status == 1) {

                    $('#fname').val('');
                    $('#lname').val('');
                    $('#cls-email').val('');
                    $('#phone').val('');
                    $('#productname').val('');
                    $('#serial_no').val('');
                    $('#purchase_date').val('');
                    $('#purchase_receipt').val('');
                    $(".cls-msg").show().html(response.message);
                } else {
                    $(".cls-msg").show().html(response.message);
                }
            },

            error: function () {
                $('body').loader('hide');
                $(".cls-msg").show().html("Something went wrong.");
            }
        });
    });
});
</script>




