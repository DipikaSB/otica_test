            var fname = $('#fname').val();
            $.ajax({
                url : '<?php /* @escapeNotVerified */ echo $block->ResentOtp(); ?>',
                type : 'POST',
                data: {
                     email_id:email_id,
                     fname:fname
                },
                dataType:'json',
