<script>
requirejs(['jquery'], function($) {
    $(document).ready(function() {
    $('#field-id').bind('keyup', function(){
        alert($(this).val());
    });
});
/*contry name get start*/
$(document).on('change','#country',function() {
    var param = 'country='+jQuery('#country').val();
    jQuery.ajax({
        showLoader: true,
        url: '<?php /* @escapeNotVerified */ echo $block->getCountryAction(); ?>',
        data: param,
        type: "GET",
        dataType: 'json'
         }).done(function (data) {
            $('#state').empty();
            if(data.value=='')
            {
                $('.field.states.required').show();
                $('.field.region.required').hide();
            }
            else
            {
                $('#state').append(data.value);
                $('.field.states.required').hide();
                $('.field.region.required').show();
            }
         });
    });

function otpverify(){
    showLoader: true;
    $(".showcontrol").show();
    var email_id = $('#cls-email').val();
    var fname = $('#fname').val();
    $.ajax({
    url : '<?php /* @escapeNotVerified */ echo $block->SentOtp(); ?>',
    type : 'POST',
    data: {
        email_id:email_id,
        fname:fname
    },
    dataType:'json',
    success : function(data) {
        showLoader: false;
        jQuery("#but-otp-send-wholes").hide();
        jQuery("#but-otp-send-wholes").attr('disabled','disabled');
        $(".cls-otpmessaages").show();
        $(".cls-otpmessaages div").html('');
        if(data['status'] == 1)
        {
           jQuery(".messages .cls-otpmessaages").removeClass('error');
           jQuery(".messages .cls-otpmessaages").addClass("success");
           jQuery(".messages .cls-otpmessaages div").html("OTP is sent to you on "+email_id+".");
           setTimeout(function() { $(".cls-otpmessaages").hide(); }, 20000);
        }
        else
        {
            jQuery(".messages .cls-otpmessaages").removeClass('success');
            jQuery(".messages .cls-otpmessaages").addClass("error");
            var emailid = origin+'/checkout/#shipping';
            jQuery(".messages .cls-otpmessaages div").html("Please try another Email Id. <span class='cls-editurl'><a title='Update Your Email Id' href='"+emailid+"'>Update Your Email Id</a></span>");
            setTimeout(function() { $(".cls-otpmessaages").hide(); }, 60000);
        }   
    },
        error : function(request,error)
        {
            alert("Error");
        }
    });    
}
/*contry name get end*/
 /*save and sent mobile otp start */
$("#but-otp-send-wholes").click(function(e){
    $(".cls-msg").hide();
    var data = $('.mage-error').text();
    otpverify();
});
/*save and sent mobile otp end*/
    let timerOn = true;
    function timerResendOtp(remaining) {
        console.log("comming in function");
        var m = Math.floor(remaining / 60);
        var s = remaining % 60;
          
        m = m < 10 ? '0' + m : m;
        s = s < 10 ? '0' + s : s;
        document.getElementById('clsresendotptime').innerHTML = 'in <strong>'+ m + ':' + s+'s</strong>';
        remaining -= 1;  
        if(remaining >= 0 && timerOn) {
            setTimeout(function() {
                timerResendOtp(remaining);
            }, 1000);
            return;
        }
        if(!timerOn) {
            // Do validate stuff here
            return;
        }
        // Do timeout stuff here
        $("#but-otp-resend").show();
        $(".clsresendotpspan").hide();
        $("#but-otp-resend").removeAttr('disabled');
    }
     /* save and send email and mobile otp start*/
        $(document).on("click","#but-otp-resend-wholes",function(){
            showLoader: true;
            let timerOn = true;
            $("#but-otp-resend-wholes").html('Sending');
