          /* COD verification code start*/
       $(document).on("click","#wholes-verifiy-otp",function(){
         var email_id = $('#cls-email').val();
         var postotp = $('#verifytestotp').val();
       if(postotp!=''){
           $.ajax({
                url : '<?php /* @escapeNotVerified */ echo $block->getVerification(); ?>',
                type : 'POST',
                data: {
                    email_id:email_id,
                    postotp:postotp
                },
                    dataType:'json',
                    success : function(data) {    
                        $(".cls-otpmessaages").show();
                        $(".cls-otpmessaages div").html('');          
                        if(data == 'Yes')
                        {
                            jQuery(".cls-wholesale-inquiry").show();
                            jQuery(".messages .cls-otpmessaages").removeClass('error');
                            jQuery(".messages .cls-otpmessaages").addClass("success");
                            jQuery(".messages .cls-otpmessaages div").html("OTP is verified successfully. Kindly confirm your order.");
                            $("#btn-wholesale-inquiry").prop("disabled",false);
                            $("#cls-email").prop("disabled",true);
                            setTimeout(function() { $(".cls-otpmessaages").hide(); }, 20000);
                            jQuery(".otp-success").show();
                            jQuery(".showcontrol").hide();
                            jQuery(".resendotp").hide();
                        }
                        else
                        {
                            jQuery(".messages .cls-otpmessaages").removeClass('success');
                            jQuery(".messages .cls-otpmessaages").addClass("error");
                            jQuery(".messages .cls-otpmessaages div").html("You entered wrong OTP.");
                            setTimeout(function() { $(".cls-otpmessaages").hide(); }, 20000);

                        }
                    },
                    error : function(request,error)
                    {
                        $(".cls-otpmessaages").show();
                        $(".cls-otpmessaages div").html('');
                        jQuery(".messages .cls-otpmessaages").removeClass('success');
                        jQuery(".messages .cls-otpmessaages").addClass("error");
                        jQuery(".messages .cls-otpmessaages div").html("You entered wrong OTP.");
                        setTimeout(function() { $(".cls-otpmessaages").hide(); }, 20000);
                    }
                });

        }else{
            jQuery(".messages .cls-otpmessaages").removeClass('success');
            jQuery(".messages .cls-otpmessaages").addClass("error");
            jQuery(".messages .cls-otpmessaages div").html("Please Enter OTP (5 Digits Only).");
            setTimeout(function() { $(".cls-otpmessaages").hide(); }, 20000);
        }
       
       });
       /* COD verification code end*/
       /*submit form*/
        $(document).on("click","#btn-wholesale-inquiry",function(){
         showLoader: true;
         var fname = $('#fname').val();   
         var lname = $('#lname').val(); 
         var email_id = $('#cls-email').val();
         var phone = $('#phone').val();
         var country = $('#country').val();
         var productsku = $('#productsku').val();
         var comment = $('#comment').val();
           $.ajax({
                url : '<?php /* @escapeNotVerified */ echo $block->getforendSave(); ?>',
                type : 'POST',
                data: {
                    fname:fname,
                    lname:lname,
                    email_id:email_id,
                    phone:phone,
                    country:country,
                    productsku:productsku,
                    comment:comment
                    },
                    dataType:'json',
                    success : function(data) {          
                        if(data.status == 1)
                        {
                           showLoader: false;
