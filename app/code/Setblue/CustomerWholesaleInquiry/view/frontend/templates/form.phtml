                    showLoader: false;
                    $("#but-otp-resend-wholes").html('RESEND OTP');
                    $(".cls-otpmessaages").show();
                    $(".cls-otpmessaages div").html('');
                    if(data['status'] == 1)
                    {
                        $("#but-otp-resend-wholes").hide();
                        $(".clsresendotpspan").show();
