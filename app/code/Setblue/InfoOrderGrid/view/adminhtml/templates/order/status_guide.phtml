<style>
.order-status-guide{
    background:#fff;
    border:1px solid #d6d6d6;
    border-radius:6px;
    padding:18px;
    margin-bottom:20px;
    box-shadow:0 1px 3px rgba(0,0,0,.05);
}

.guide-title{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:20px;
    font-weight:600;
    margin-bottom:18px;
    color:#303030;
}

.guide-title i{
    color:#6a6a6a;
}

.status-list{
    display:flex;
    gap:15px;
}

.status-card{
    flex:1;
    display:flex;
    align-items:center;
