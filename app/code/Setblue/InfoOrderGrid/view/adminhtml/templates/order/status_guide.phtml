</style>

<style>
.status-card.active {
    box-shadow: 0 4px 16px rgba(0,0,0,.18);
    transform: translateY(-2px);
    outline: 2px solid #1979c3;
    outline-offset: 1px;
}

.status-card.active::after {
    content: '\2713';
    position: absolute;
    top: 4px;
    right: 8px;
    font-size: 14px;
    font-weight: bold;
    color: #1979c3;
}

.status-card {
    position: relative;
}

.show-all-orders {
    display: none;
    margin-top: 12px;
    text-align: right;
}

.show-all-orders a {
    color: #1979c3;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
}

.show-all-orders a:hover {
    text-decoration: underline;
}

.show-all-orders.visible {
    display: block;
}
</style>

<div class="show-all-orders" id="show-all-orders-link">
    <a onclick="resetOrderStatusFilter()">✕ Clear Filter — Show All Orders</a>
</div>

<script>
    function filterOrderByStatus(status) {
        require(['uiRegistry'], function (registry) {
            // Find the sales order grid data provider
            var provider = registry.get('sales_order_grid.sales_order_grid_data_source');

            if (provider) {
                // Set the status filter
                provider.set('params.filters.status', status);

                // Reload the grid
                provider.reload();
            }

            // Highlight the active card
            var cards = document.querySelectorAll('.status-card');
            cards.forEach(function(card) {
                card.classList.remove('active');
            });

            var clickedCard = document.querySelector('.status-card[data-status="' + status + '"]');
            if (clickedCard) {
                clickedCard.classList.add('active');
            }

            // Show the "Show All" link
            var showAllLink = document.getElementById('show-all-orders-link');
            if (showAllLink) {
                showAllLink.classList.add('visible');
            }
        });
    }

    function resetOrderStatusFilter() {
        require(['uiRegistry'], function (registry) {
            var provider = registry.get('sales_order_grid.sales_order_grid_data_source');

            if (provider) {
                // Remove the status filter
                var filters = provider.get('params.filters');
                if (filters && filters.status) {
                    delete filters.status;
                    provider.set('params.filters', filters);
                }

                // Reload the grid
                provider.reload();
            }

            // Remove active state from all cards
            var cards = document.querySelectorAll('.status-card');
            cards.forEach(function(card) {
                card.classList.remove('active');
            });

            // Hide the "Show All" link
            var showAllLink = document.getElementById('show-all-orders-link');
            if (showAllLink) {
                showAllLink.classList.remove('visible');
            }
        });
    }
</script>