<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="core_layout_render_element">
        <observer name="Setblue_gst_number_add_to_order_view"
                  instance="Setblue\GST\Observer\AddHtmlToOrderShippingView" />
    </event>
    <event name="adminhtml_sales_order_create_process_data">
        <observer name="Setblue_gst_number_adminhtml_sales_order_create_process_data"
                  instance="Setblue\GST\Observer\AdminhtmlSalesOrderCreateProcessData"/>
    </event>
    <event name="sales_order_invoice_save_before">
        <observer name="Setblue_gst_to_invoice"
                  instance="Setblue\GST\Observer\SaveGstToInvoice" />
    </event>
</config>